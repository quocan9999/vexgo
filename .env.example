# Cơ sở dữ liệu MySQL và các kết nối Prisma dùng cho môi trường local.
# DATABASE_URL dùng bởi API; MIGRATION_URL dùng Prisma CLI; URL shadow phải trỏ database riêng.
MYSQL_ROOT_PASSWORD=vexgo_root_dev
MYSQL_DATABASE=vexgo
MYSQL_USER=vexgo_app
MYSQL_PASSWORD=vexgo_dev_password
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080
DATABASE_URL=mysql://vexgo_app:CHANGE_ME_MYSQL_PASSWORD@127.0.0.1:3306/vexgo
MIGRATION_URL=mysql://root:CHANGE_ME_MYSQL_ROOT_PASSWORD@127.0.0.1:3306/vexgo
SHADOW_DATABASE_URL=mysql://root:CHANGE_ME_MYSQL_ROOT_PASSWORD@127.0.0.1:3306/vexgo_shadow

# API dùng chung cho Customer Web và Admin Web. URL frontend được khai báo riêng trong mẫu của từng app.
PORT=4000
# Cloudinary chỉ dùng ở Backend. Không nhúng API_SECRET trong Web/Mobile.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# dev/test/prod; production bắt buộc prod. Backend tự phân folder theo tenant/xe.
CLOUDINARY_ENVIRONMENT=dev
# Tài khoản mới dùng dynamic; chỉ chọn fixed nếu Console xác nhận legacy Fixed folders.
CLOUDINARY_FOLDER_MODE=dynamic
BUSINESS_TIME_ZONE=Asia/Ho_Chi_Minh
PAYMENT_DEMO_MODE=false

# Danh sách origin được phép gọi API và dùng refresh cookie của Admin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ADMIN_AUTH_COOKIE_ALLOWED_ORIGINS=http://localhost:3001

# Xác thực, OTP và giới hạn đăng nhập.
SMS_PROVIDER=console
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PROOF_TTL_SECONDS=600
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_TTL_MS=900000

# Khóa tùy chọn cho các cổng thanh toán khác; chỉ điền khi tích hợp cổng đó.
MOMO_SECRET_KEY=
VNPAY_HASH_SECRET=
ZALOPAY_KEY2=

# Bí mật HMAC-SHA256 webhook SePay chỉ dùng trong backend, không đưa lên trình duyệt.
SEPAY_WEBHOOK_SECRET=replace-with-a-random-sepay-hmac-secret
# Số tài khoản thụ hưởng SePay; nhập đúng chuỗi accountNumber SePay gửi trong webhook.
SEPAY_ACCOUNT_NUMBER=

# Cấu hình nhà cung cấp hoàn tiền; để trống nếu chưa tích hợp.
REFUND_PROVIDER_URL=
REFUND_PROVIDER_TOKEN=
REFUND_PROCESS_INTERVAL_MS=30000

# Customer email worker. Never put these secrets in Flutter defines.
# Keep disabled until migration is deployed and SMTP is configured.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Reminder scan is opt-in; notices are generated within 2h before pickup.
NOTIFICATION_REMINDERS_ENABLED=false
# Server credential path only; never place the service-account JSON in Flutter.
FCM_ENABLED=false
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

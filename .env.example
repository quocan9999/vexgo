# Local development only. Do not reuse these credentials in production.
MYSQL_ROOT_PASSWORD=vexgo_root_dev
MYSQL_DATABASE=vexgo
MYSQL_USER=vexgo_app
MYSQL_PASSWORD=vexgo_dev_password
MYSQL_PORT=3306

# Prisma Client connection used by the NestJS API.
DATABASE_URL=mysql://vexgo_app:URL_ENCODED_MYSQL_PASSWORD@127.0.0.1:3306/vexgo

# Comma-separated browser origins allowed to call the API. Defaults to the
# Customer and Admin local development URLs outside production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Only these exact origins may use Admin's HttpOnly refresh-cookie transport.
ADMIN_AUTH_COOKIE_ALLOWED_ORIGINS=http://localhost:3001

# Time zone used to interpret business calendar dates by the API.
BUSINESS_TIME_ZONE=Asia/Ho_Chi_Minh

# Local Prisma CLI connection used for migrations. migrate dev uses this
# separate shadow database; do not point it to vexgo. migrate deploy does not
# use SHADOW_DATABASE_URL.
MIGRATION_URL=mysql://root:URL_ENCODED_MYSQL_ROOT_PASSWORD@127.0.0.1:3306/vexgo
SHADOW_DATABASE_URL=mysql://root:URL_ENCODED_MYSQL_ROOT_PASSWORD@127.0.0.1:3306/vexgo_shadow

# Registration OTP. Secrets are required, separate random values of at least
# 32 characters; the API refuses to start while a placeholder remains.
# The console sender is for local development only.
SMS_PROVIDER=console
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PROOF_TTL_SECONDS=600

# Access JWT and opaque refresh sessions. JWT_ACCESS_SECRET is required and
# must be a separate random value of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Login attempts per IP per API instance; use a shared store/gateway limiter
# when deploying multiple API instances.
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_TTL_MS=900000

# Refund provider endpoint. The API stores refunds durably first, then sends
# them after the cancellation transaction commits with a stable idempotency key.
REFUND_PROVIDER_URL=
REFUND_PROVIDER_TOKEN=
REFUND_PROCESS_INTERVAL_MS=30000

# Local development only. Do not reuse these credentials in production.
MYSQL_ROOT_PASSWORD=vexgo_root_dev
MYSQL_DATABASE=vexgo
MYSQL_USER=vexgo_app
MYSQL_PASSWORD=vexgo_dev_password
MYSQL_PORT=3306

# Prisma Client connection used by the NestJS API.
DATABASE_URL=mysql://vexgo_app:URL_ENCODED_MYSQL_PASSWORD@127.0.0.1:3306/vexgo

# Prisma CLI connection used for migrations; migrate dev needs permission to
# create its temporary shadow database. Keep this local and out of production.
MIGRATION_URL=mysql://root:URL_ENCODED_MYSQL_ROOT_PASSWORD@127.0.0.1:3306/vexgo

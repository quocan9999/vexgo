# Cổng và địa chỉ gốc của API dành cho Admin Web.
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Chat Socket.IO: để trống sẽ dùng origin của NEXT_PUBLIC_API_URL.
# Chỉ đặt URL riêng khi socket chạy ở origin khác; không thêm /api/v1 hoặc /chat.
NEXT_PUBLIC_SOCKET_URL=
# Đổi NEXT_PUBLIC_*: restart dev; production cần build lại và restart.

# Chọn nguồn dữ liệu API cho dashboard quản trị.
NEXT_PUBLIC_ADMIN_DATA_SOURCE=api

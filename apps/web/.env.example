# Cổng và API của Customer Web. URL API cần có đúng một hậu tố /api/v1.
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Chat Socket.IO: để trống sẽ lấy origin từ API ở trên (bỏ /api/v1).
# Chỉ đặt URL riêng khi socket chạy ở origin khác; không thêm /api/v1 hoặc /chat.
NEXT_PUBLIC_SOCKET_URL=
# Đổi NEXT_PUBLIC_*: restart dev; production cần build lại và restart.

# Tài khoản nhận tiền VietQR. Điền thông tin tài khoản được cung cấp cho dự án.
NEXT_PUBLIC_SEPAY_BANK_ID=
NEXT_PUBLIC_SEPAY_ACCOUNT_NUMBER=
NEXT_PUBLIC_SEPAY_ACCOUNT_NAME=

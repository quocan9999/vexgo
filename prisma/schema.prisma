generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model BoDemMaNghiepVu {
  tienTo String @id @db.VarChar(50)
  soCuoi Int
}

model NhaXe {
  nhaXeId                  Int                       @id @default(autoincrement()) @db.Int
  maNhaXe                  String                    @unique @db.VarChar(50)
  tenNhaXe                 String                    @db.VarChar(150)
  thongTinLienHe           String?                   @db.Text
  trangThai                String                    @db.VarChar(30)
  createdAt                DateTime                  @default(now()) @db.DateTime(0)
  updatedAt                DateTime                  @default(now()) @updatedAt @db.DateTime(0)
  xes                      Xe[]
  loaiXes                  LoaiXe[]
  tuyenXes                 TuyenXe[]
  nhanViens                NhanVien[]
  khuyenMais               KhuyenMai[]
  diemGiaoNhanHangs        DiemGiaoNhanHang[]
  donGiaoDichs             DonGiaoDich[]
  cauHinhQuyenVaiTroNhaXes CauHinhQuyenVaiTroNhaXe[]
  cuocTroChuyens           CuocTroChuyen[]
  diemDonTras              DiemDonTra[]
}

model TrangNoiDung {
  trangNoiDungId Int                    @id @default(autoincrement()) @db.Int
  slug           String                 @unique @db.VarChar(191)
  loaiTrang      String                 @db.VarChar(50)
  createdAt      DateTime               @default(now()) @db.DateTime(0)
  updatedAt      DateTime               @default(now()) @updatedAt @db.DateTime(0)
  phienBans      PhienBanTrangNoiDung[]
}

model PhienBanTrangNoiDung {
  phienBanTrangNoiDungId Int          @id @default(autoincrement()) @db.Int
  soPhienBan             Int          @db.Int
  tieuDe                 String       @db.VarChar(255)
  noiDung                String       @db.LongText
  ngayHieuLucTu          DateTime     @db.Date
  ngayHieuLucDen         DateTime?    @db.Date
  trangThai              String       @db.VarChar(30)
  trangNoiDungId         Int          @db.Int
  createdAt              DateTime     @default(now()) @db.DateTime(0)
  updatedAt              DateTime     @default(now()) @updatedAt @db.DateTime(0)
  trangNoiDung           TrangNoiDung @relation(fields: [trangNoiDungId], references: [trangNoiDungId], onDelete: Restrict, onUpdate: Restrict)
  tepDinhKems            TepDinhKem[]

  @@unique([trangNoiDungId, soPhienBan], map: "PhienBanTrangNoiDung_trangNoiDungId_soPhienBan_key")
}

model TepDinhKem {
  tepDinhKemId           Int                  @id @default(autoincrement()) @db.Int
  tenTepGoc              String               @db.VarChar(255)
  storageKey             String               @unique @db.VarChar(500)
  mimeType               String               @db.VarChar(100)
  kichThuoc              BigInt               @db.BigInt
  phienBanTrangNoiDungId Int                  @db.Int
  createdAt              DateTime             @default(now()) @db.DateTime(0)
  phienBanTrangNoiDung   PhienBanTrangNoiDung @relation(fields: [phienBanTrangNoiDungId], references: [phienBanTrangNoiDungId], onDelete: Restrict, onUpdate: Restrict)

  @@index([phienBanTrangNoiDungId], map: "TepDinhKem_phienBanTrangNoiDungId_idx")
}

model LoaiXe {
  loaiXeId                   Int       @id @default(autoincrement()) @db.Int
  nhaXeId                    Int       @db.Int
  tenLoai                    String    @db.VarChar(100)
  moTa                       String?   @db.VarChar(500)
  sucChuaXeMayMacDinh        Int       @default(0) @db.Int
  sucChuaHangCongKenhMacDinh Int       @default(0) @db.Int
  sucChuaHangNheMacDinh      Int       @default(0) @db.Int
  createdAt                  DateTime  @default(now()) @db.DateTime(0)
  updatedAt                  DateTime  @default(now()) @updatedAt @db.DateTime(0)
  nhaXe                      NhaXe     @relation(fields: [nhaXeId], references: [nhaXeId], onDelete: Restrict, onUpdate: Restrict)
  xes                        Xe[]
  bangGias                   BangGia[]

  @@unique([nhaXeId, tenLoai], map: "LoaiXe_nhaXeId_tenLoai_key")
  @@unique([nhaXeId, loaiXeId], map: "LoaiXe_nhaXeId_loaiXeId_key")
}

model Xe {
  xeId      Int        @id @default(autoincrement()) @db.Int
  bienSoXe  String     @unique @db.VarChar(15)
  trangThai String     @db.VarChar(30)
  nhaXeId   Int        @db.Int
  loaiXeId  Int        @db.Int
  createdAt DateTime   @default(now()) @db.DateTime(0)
  updatedAt DateTime   @default(now()) @updatedAt @db.DateTime(0)
  nhaXe     NhaXe      @relation(fields: [nhaXeId], references: [nhaXeId], onDelete: Restrict, onUpdate: Restrict)
  loaiXe    LoaiXe     @relation(fields: [nhaXeId, loaiXeId], references: [nhaXeId, loaiXeId], onDelete: Restrict, onUpdate: Restrict)
  ghes      Ghe[]
  chuyenXes ChuyenXe[]

  @@unique([nhaXeId, xeId], map: "Xe_nhaXeId_xeId_key")
  @@index([nhaXeId, loaiXeId], map: "Xe_nhaXeId_loaiXeId_idx")
}

model Ghe {
  gheId        Int           @id @default(autoincrement()) @db.Int
  maGhe        String        @unique @db.VarChar(50)
  tenGhe       String        @db.VarChar(50)
  viTri        String?       @db.VarChar(50)
  xeId         Int           @db.Int
  tang         Int           @default(1) @db.Int
  toaDoX       Int?          @db.Int
  toaDoY       Int?          @db.Int
  createdAt    DateTime      @default(now()) @db.DateTime(0)
  updatedAt    DateTime      @default(now()) @updatedAt @db.DateTime(0)
  xe           Xe            @relation(fields: [xeId], references: [xeId], onDelete: Restrict, onUpdate: Restrict)
  gheChuyenXes GheChuyenXe[]

  @@unique([xeId, tenGhe], map: "Ghe_index_1")
  @@unique([xeId, tang, toaDoX, toaDoY], map: "Ghe_xeId_tang_toaDoX_toaDoY_key")
}

model TuyenXe {
  tuyenXeId            Int                   @id @default(autoincrement()) @db.Int
  maTuyenXe            String                @db.VarChar(50)
  diemDi               String                @db.VarChar(100)
  diemDen              String                @db.VarChar(100)
  thoiGianChayPhut     Int?                  @db.Int
  trangThai            String                @db.VarChar(30)
  nhaXeId              Int                   @db.Int
  createdAt            DateTime              @default(now()) @db.DateTime(0)
  updatedAt            DateTime              @default(now()) @updatedAt @db.DateTime(0)
  nhaXe                NhaXe                 @relation(fields: [nhaXeId], references: [nhaXeId], onDelete: Restrict, onUpdate: Restrict)
  chuyenXes            ChuyenXe[]
  bangGias             BangGia[]
  diemGiaoNhanTuyenXes DiemGiaoNhanTuyenXe[]
  tuyenXeDiemDungs     TuyenXeDiemDung[]

  @@unique([nhaXeId, maTuyenXe], map: "TuyenXe_index_2")
  @@unique([nhaXeId, tuyenXeId], map: "TuyenXe_nhaXeId_tuyenXeId_key")
}

model ChuyenXe {
  chuyenXeId          Int            @id @default(autoincrement()) @db.Int
  maChuyenXe          String         @unique @db.VarChar(50)
  ngayKhoiHanh        DateTime       @db.Date
  gioKhoiHanh         DateTime       @db.Time(0)
  gioDen              DateTime?      @db.Time(0)
  nhanGuiHang         Boolean        @default(false)
  sucChuaXeMay        Int            @db.Int
  sucChuaHangCongKenh Int            @db.Int
  sucChuaHangNhe      Int            @db.Int
  trangThai           String         @db.VarChar(30)
  nhaXeId             Int            @db.Int
  tuyenXeId           Int            @db.Int
  xeId                Int            @db.Int
  createdAt           DateTime       @default(now()) @db.DateTime(0)
  updatedAt           DateTime       @default(now()) @updatedAt @db.DateTime(0)
  xe                  Xe             @relation(fields: [nhaXeId, xeId], references: [nhaXeId, xeId], onDelete: Restrict, onUpdate: Restrict)
  tuyenXe             TuyenXe        @relation(fields: [nhaXeId, tuyenXeId], references: [nhaXeId, tuyenXeId], onDelete: Restrict, onUpdate: Restrict)
  gheChuyenXes        GheChuyenXe[]
  giuChos             GiuCho[]
  phieuGuiHangs       PhieuGuiHang[]
  phanHois            PhanHoi[]

  diemDonTraChuyenXes DiemDonTraChuyenXe[]
  @@index([trangThai, ngayKhoiHanh, gioKhoiHanh], map: "ChuyenXe_departure_due_idx")
}

model GheChuyenXe {
  gheChuyenXeId Int      @id @default(autoincrement()) @db.Int
  trangThai     String   @db.VarChar(30)
  chuyenXeId    Int      @db.Int
  gheId         Int      @db.Int
  tang          Int?     @db.Int
  toaDoX        Int?     @db.Int
  toaDoY        Int?     @db.Int
  giuChoId      Int?     @db.Int
  createdAt     DateTime @default(now()) @db.DateTime(0)
  updatedAt     DateTime @default(now()) @updatedAt @db.DateTime(0)
  chuyenXe      ChuyenXe @relation(fields: [chuyenXeId], references: [chuyenXeId], onDelete: Restrict, onUpdate: Restrict)
  ghe           Ghe      @relation(fields: [gheId], references: [gheId], onDelete: Restrict, onUpdate: Restrict)
  giuCho        GiuCho?  @relation(fields: [giuChoId], references: [giuChoId], onDelete: SetNull, onUpdate: Restrict)
  ves           Ve[]

  @@unique([chuyenXeId, gheId], map: "GheChuyenXe_index_3")
  @@index([giuChoId], map: "GheChuyenXe_giuChoId_idx")
}

model GiuCho {
  giuChoId     Int           @id @default(autoincrement()) @db.Int
  tokenHash    String        @unique @db.Char(64)
  chuyenXeId   Int           @db.Int
  khachHangId  Int?          @db.Int
  hetHanLuc    DateTime      @db.DateTime(3)
  trangThai    String        @default("DANG_GIU") @db.VarChar(30)
  createdAt    DateTime      @default(now()) @db.DateTime(3)
  updatedAt    DateTime      @default(now()) @updatedAt @db.DateTime(3)
  chuyenXe     ChuyenXe      @relation(fields: [chuyenXeId], references: [chuyenXeId], onDelete: Restrict, onUpdate: Restrict)
  khachHang    KhachHang?    @relation(fields: [khachHangId], references: [khachHangId], onDelete: Restrict, onUpdate: Restrict)
  gheChuyenXes GheChuyenXe[]

  @@index([chuyenXeId, hetHanLuc], map: "GiuCho_chuyenXeId_hetHanLuc_idx")
  @@index([khachHangId], map: "GiuCho_khachHangId_idx")
}

model BangGia {
  bangGiaId  Int       @id @default(autoincrement()) @db.Int
  giaNiemYet Decimal   @db.Decimal(18, 2)
  tuNgay     DateTime  @db.Date
  denNgay    DateTime? @db.Date
  trangThai  String    @db.VarChar(30)
  nhaXeId    Int       @db.Int
  tuyenXeId  Int       @db.Int
  loaiXeId   Int       @db.Int
  createdAt  DateTime  @default(now()) @db.DateTime(0)
  updatedAt  DateTime  @default(now()) @updatedAt @db.DateTime(0)
  tuyenXe    TuyenXe   @relation(fields: [nhaXeId, tuyenXeId], references: [nhaXeId, tuyenXeId], onDelete: Restrict, onUpdate: Restrict)
  loaiXe     LoaiXe    @relation(fields: [nhaXeId, loaiXeId], references: [nhaXeId, loaiXeId], onDelete: Restrict, onUpdate: Restrict)
  ves        Ve[]

  @@index([nhaXeId, tuyenXeId], map: "BangGia_nhaXeId_tuyenXeId_idx")
  @@index([nhaXeId, loaiXeId], map: "BangGia_nhaXeId_loaiXeId_idx")
  @@index([tuyenXeId, loaiXeId], map: "BangGia_index_4")
}

model TaiKhoan {
  taiKhoanId                   Int                           @id @default(autoincrement()) @db.Int
  hoTen                        String                        @db.VarChar(100)
  soDienThoai                  String                        @unique @db.VarChar(16)
  matKhau                      String                        @db.VarChar(255)
  ngaySinh                     DateTime?                     @db.Date
  cccd                         String?                       @db.Char(12)
  email                        String?                       @unique(map: "TaiKhoan_email_key") @db.VarChar(150)
  daXacThucSoDienThoai         Boolean
  trangThai                    String                        @db.VarChar(30)
  createdAt                    DateTime                      @default(now()) @db.DateTime(0)
  updatedAt                    DateTime                      @default(now()) @updatedAt @db.DateTime(0)
  khachHang                    KhachHang?
  nhanVien                     NhanVien?
  taiKhoanVaiTros              TaiKhoanVaiTro[]
  phienDangNhaps               PhienDangNhap[]
  lichSuTrangThaiPhieuGuiHangs LichSuTrangThaiPhieuGuiHang[]
  lichSuTrangThaiPhieuDatVes   LichSuTrangThaiPhieuDatVe[]
  lichSuTrangThaiVes           LichSuTrangThaiVe[]
  tinNhanHoTros                TinNhanHoTro[]
}

model PhienDangNhap {
  phienDangNhapId  Int            @id @default(autoincrement()) @db.Int
  sessionId        String         @unique @db.Char(36)
  refreshTokenHash String         @unique @db.Char(64)
  hetHanLuc        DateTime       @db.DateTime(3)
  thuHoiLuc        DateTime?      @db.DateTime(3)
  tokenThayTheId   Int?           @unique @db.Int
  taiKhoanId       Int            @db.Int
  createdAt        DateTime       @default(now()) @db.DateTime(3)
  updatedAt        DateTime       @default(now()) @updatedAt @db.DateTime(3)
  taiKhoan         TaiKhoan       @relation(fields: [taiKhoanId], references: [taiKhoanId], onDelete: Restrict, onUpdate: Restrict)
  tokenThayThe     PhienDangNhap? @relation("PhienDangNhapRotation", fields: [tokenThayTheId], references: [phienDangNhapId], onDelete: Restrict, onUpdate: Restrict)
  tokenGoc         PhienDangNhap? @relation("PhienDangNhapRotation")

  @@index([taiKhoanId, thuHoiLuc, hetHanLuc], map: "PhienDangNhap_account_active_idx")

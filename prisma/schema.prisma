model DanhMucDiaDiem {
  diaDiemId           Int                  @id @default(autoincrement()) @db.Int
  maDiaDiem           String               @unique(map: "DanhMucDiaDiem_maDiaDiem_key") @db.VarChar(50)
  code                Int                  @db.Int
  tenDiaDiem          String               @db.VarChar(150)
  tenKhongDau         String               @db.VarChar(150)
  capDiaDiem          String               @db.VarChar(50)
  laDiaDanhCu         Boolean              @default(false)
  chuThichSapNhap     String?              @db.VarChar(255)
  noiBat              Boolean              @default(false)
  thuTuHienThi        Int                  @default(0) @db.Int
  trangThai           String               @default("HOAT_DONG") @db.VarChar(30)
  diaDiemChaId        Int?                 @db.Int
  createdAt           DateTime             @default(now()) @db.DateTime(0)
  updatedAt           DateTime             @default(now()) @updatedAt @db.DateTime(0)
  diaDiemCha          DanhMucDiaDiem?      @relation("DanhMucDiaDiem_ChaCon", fields: [diaDiemChaId], references: [diaDiemId], onDelete: Restrict, onUpdate: Restrict)
  danhMucCon          DanhMucDiaDiem[]     @relation("DanhMucDiaDiem_ChaCon")
  bangSapNhapMoi      BangSapNhapDiaDiem[] @relation("BangSapNhap_DiaDiemMoi")
  bangSapNhapCu       BangSapNhapDiaDiem[] @relation("BangSapNhap_DiaDiemCu")
  diemDonTrasTheoMoi  DiemDonTra[]         @relation("DiemDonTra_DiaDiemMoi")
  diemDonTrasTheoCu   DiemDonTra[]         @relation("DiemDonTra_DiaDiemCu")

  @@unique([code, laDiaDanhCu], map: "DanhMucDiaDiem_code_laDiaDanhCu_key")
  @@index([diaDiemChaId], map: "DanhMucDiaDiem_diaDiemChaId_idx")
  @@index([laDiaDanhCu, capDiaDiem], map: "DanhMucDiaDiem_laDiaDanhCu_capDiaDiem_idx")
  @@index([tenKhongDau], map: "DanhMucDiaDiem_tenKhongDau_idx")
}

model BangSapNhapDiaDiem {
  bangSapNhapDiaDiemId Int             @id @default(autoincrement()) @db.Int
  diaDiemMoiId         Int             @db.Int
  diaDiemCuId          Int             @db.Int
  createdAt            DateTime        @default(now()) @db.DateTime(0)
  diaDiemMoi           DanhMucDiaDiem  @relation("BangSapNhap_DiaDiemMoi", fields: [diaDiemMoiId], references: [diaDiemId], onDelete: Restrict, onUpdate: Restrict)
  diaDiemCu            DanhMucDiaDiem  @relation("BangSapNhap_DiaDiemCu", fields: [diaDiemCuId], references: [diaDiemId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([diaDiemCuId], map: "BangSapNhapDiaDiem_diaDiemCuId_key")
  @@unique([diaDiemMoiId, diaDiemCuId], map: "BangSapNhapDiaDiem_moi_cu_key")
  @@index([diaDiemCuId], map: "BangSapNhapDiaDiem_diaDiemCuId_idx")
}

model DiemDonTra {
  diemDonTraId        Int                  @id @default(autoincrement()) @db.Int
  maDiem              String               @db.VarChar(50)
  tenDiem             String               @db.VarChar(150)
  loaiDiem            String               @db.VarChar(50)
  diaChi              String               @db.VarChar(255)
  diaDiemMoiId        Int                  @db.Int
  diaDiemCuId         Int                  @db.Int
  viDo                Decimal?             @db.Decimal(10, 7)
  kinhDo              Decimal?             @db.Decimal(10, 7)
  soDienThoai         String?              @db.VarChar(20)
  trangThai           String               @default("HOAT_DONG") @db.VarChar(30)
  nhaXeId             Int                  @db.Int
  benTrungChuyenId    Int?                 @db.Int
  createdAt           DateTime             @default(now()) @db.DateTime(0)
  updatedAt           DateTime             @default(now()) @updatedAt @db.DateTime(0)
  nhaXe               NhaXe                @relation(fields: [nhaXeId], references: [nhaXeId], onDelete: Restrict, onUpdate: Restrict)
  diaDiemMoi          DanhMucDiaDiem       @relation("DiemDonTra_DiaDiemMoi", fields: [diaDiemMoiId], references: [diaDiemId], onDelete: Restrict, onUpdate: Restrict)
  diaDiemCu           DanhMucDiaDiem       @relation("DiemDonTra_DiaDiemCu", fields: [diaDiemCuId], references: [diaDiemId], onDelete: Restrict, onUpdate: Restrict)
  diemDonTraChuyenXes DiemDonTraChuyenXe[]
  benTrungChuyen      DiemDonTra?          @relation("DiemDonTra_BenTrungChuyen", fields: [benTrungChuyenId], references: [diemDonTraId], onDelete: Restrict, onUpdate: Restrict)
  diemTrungChuyens    DiemDonTra[]         @relation("DiemDonTra_BenTrungChuyen")
  tuyenXeDiemDungs    TuyenXeDiemDung[]

  @@unique([nhaXeId, maDiem], map: "DiemDonTra_nhaXeId_maDiem_key")
  @@index([diaDiemMoiId], map: "DiemDonTra_diaDiemMoiId_idx")
  @@index([diaDiemCuId], map: "DiemDonTra_diaDiemCuId_idx")
  @@index([trangThai], map: "DiemDonTra_trangThai_idx")
  @@index([benTrungChuyenId], map: "DiemDonTra_benTrungChuyenId_idx")
}

model DiemDonTraChuyenXe {
  diemDonTraChuyenXeId Int         @id @default(autoincrement()) @db.Int

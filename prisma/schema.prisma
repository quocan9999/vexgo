  ghiChu               String?     @db.VarChar(255)
  thuTu                Int         @default(1) @db.Int
  phuPhi               Decimal     @default(0.00) @db.Decimal(18, 2)
  createdAt            DateTime    @default(now()) @db.DateTime(0)
  updatedAt            DateTime    @default(now()) @updatedAt @db.DateTime(0)
  chuyenXe             ChuyenXe    @relation(fields: [chuyenXeId], references: [chuyenXeId], onDelete: Restrict, onUpdate: Restrict)
  diemDonTra           DiemDonTra  @relation(fields: [diemDonTraId], references: [diemDonTraId], onDelete: Restrict, onUpdate: Restrict)
  vesDon               Ve[]        @relation("Ve_DiemDonChuyenXe")
  vesTra               Ve[]        @relation("Ve_DiemTraChuyenXe")

  @@unique([chuyenXeId, diemDonTraId, loaiDiem], map: "DiemDonTraChuyenXe_chuyen_diem_loai_key")
  @@index([chuyenXeId, loaiDiem], map: "DiemDonTraChuyenXe_chuyenXeId_loaiDiem_idx")
  @@index([diemDonTraId], map: "DiemDonTraChuyenXe_diemDonTraId_idx")
}


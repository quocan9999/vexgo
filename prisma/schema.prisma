model Quyen {
  quyenId                         Int                              @id @default(autoincrement()) @db.Int
  tenQuyen                        String                           @unique @db.VarChar(100)
  moTa                            String?                          @db.VarChar(255)
  createdAt                       DateTime                         @default(now()) @db.DateTime(0)

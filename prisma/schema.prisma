  @@index([soDienThoai, mucDich, updatedAt], map: "YeuCauOtp_phone_purpose_updated_idx")
}

model KhachHang {
  khachHangId        Int                 @id @default(autoincrement()) @db.Int
  maKhachHang        String              @unique @db.VarChar(50)
  diemTichLuy        Int                 @default(0) @db.Int
  taiKhoanId         Int                 @unique @db.Int
  createdAt          DateTime            @default(now()) @db.DateTime(0)
  updatedAt          DateTime            @default(now()) @updatedAt @db.DateTime(0)
  taiKhoan           TaiKhoan            @relation(fields: [taiKhoanId], references: [taiKhoanId], onDelete: Restrict, onUpdate: Restrict)
  donGiaoDichs       DonGiaoDich[]
  suDungKhuyenMais   SuDungKhuyenMai[]
  thongBaoNguoiNhans ThongBaoNguoiNhan[]
  cuocTroChuyens     CuocTroChuyen[]
